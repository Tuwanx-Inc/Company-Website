<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ==============================================================================
# Static caching & compression (Tuwanx)
# Speeds up repeat visits and cuts transfer size. Every block is wrapped in
# <IfModule> so the site keeps working even if a module is unavailable on the
# host. Third-party assets (Font Awesome, Google Fonts) are cached by their own
# CDNs — these rules only affect files served from tuwanx.com.
# ==============================================================================

# --- Gzip text responses (HTML / CSS / JS / SVG / JSON) to reduce bytes ------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Per-type cache lifetimes (mod_expires emits Cache-Control: max-age) ------
<IfModule mod_expires.c>
    ExpiresActive On

    # Images: filenames are NOT content-hashed, so keep this moderate. If you
    # replace an image using the SAME name, returning visitors keep the cached
    # copy until this window passes — rename the file to force an instant update.
    ExpiresByType image/jpeg    "access plus 1 month"
    ExpiresByType image/png     "access plus 1 month"
    ExpiresByType image/webp    "access plus 1 month"
    ExpiresByType image/avif    "access plus 1 month"
    ExpiresByType image/gif     "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon  "access plus 1 year"

    # Fonts change rarely, so a year is safe.
    ExpiresByType font/woff2    "access plus 1 year"
    ExpiresByType font/woff     "access plus 1 year"
</IfModule>

# --- CSS & JS: cache a year, immutable ---------------------------------------
# Every CSS/JS file on this site is a fingerprinted Vite build asset (its name
# changes whenever its content changes), so it can never go stale — the strongest,
# safest caching for repeat visits. mod_headers here overrides mod_expires above.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
